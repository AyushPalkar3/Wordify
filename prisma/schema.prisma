// Prisma schema for the AI English Vocabulary Learning Application.
//
// Per project spec: words and phrases are ALWAYS stored in separate,
// dedicated tables. Do not collapse them into one generic table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  words            Word[]
  phrases          Phrase[]
  practiceSessions PracticeSession[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Word
// ---------------------------------------------------------------------------

model Word {
  id              String     @id @default(cuid())
  userId          String
  word            String
  meaning         String
  exampleSentence String
  partOfSpeech    String
  difficulty      Difficulty
  synonyms        String[]   @default([])
  // Optional structured list of ALL distinct meanings when a word has more
  // than one commonly-used sense (e.g. "bank", "native", "light"). Shape:
  // [{ meaning, exampleSentence, partOfSpeech, context }, ...], 1-4 entries.
  // Null/absent for existing rows saved before this feature, and for words
  // with only one meaning going forward — the columns above always hold the
  // primary meaning regardless, so nothing that reads only those breaks.
  meanings        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user shouldn't save the exact same word twice.
  // App layer does a case-insensitive check before insert (Phase 5);
  // this is the DB-level backstop for exact duplicates.
  @@unique([userId, word])
  @@index([userId])
  @@map("words")
}

// ---------------------------------------------------------------------------
// Phrase
// ---------------------------------------------------------------------------

model Phrase {
  id              String     @id @default(cuid())
  userId          String
  phrase          String
  meaning         String
  exampleSentence String
  phraseType      String
  difficulty      Difficulty
  similarPhrases  String[]   @default([])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phrase])
  @@index([userId])
  @@map("phrases")
}

// ---------------------------------------------------------------------------
// PracticeSession
// ---------------------------------------------------------------------------

model PracticeSession {
  id                  String       @id @default(cuid())
  userId              String
  numberOfItems       Int
  practiceType        PracticeType
  // Snapshot of the items drawn for this session (id, kind, text) —
  // stored as JSON so history survives even if the source word/phrase
  // is later deleted from the library.
  selectedItems       Json
  // Snapshot of the AI-generated sentence per item.
  generatedSentences  Json
  createdAt           DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("practice_sessions")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum PracticeType {
  words
  phrases
  mixed
}
